# SkyGuard AI — backend environment template
# Copy this file to `.env` and fill in your real Groq key. This template is
# safe to commit; `.env` (with the real secret) is git-ignored.

# ── Groq (OpenAI-compatible API) ───────────────────────────────────────────
# OpenAI's open-weight GPT-OSS 20B model, served on Groq.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Optional generation defaults ───────────────────────────────────────────
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
